<link rel="stylesheet" href="{{ 'foxy-opening-times.css' | asset_url }}">

{% unless section.settings.disable_dynamic_script %}
  <script src="{{ 'foxy-opening-times.js' | asset_url }}" defer></script>
{% endunless %}

{%- comment -%}
  NOTE: foxy-opening-times.js depends on the following markup contract:
  - .foxy-opening-times (with the holiday data-* attributes)
  - .opening-times-table, where the FIRST <tr> is the header row
  - each day row's first <td> contains ONLY the weekday name (e.g. "Monday")
  - opening/closing times live in td:nth-child(2) / td:nth-child(3)
  - .exceptions-note (populated with holiday exceptions)
  Keep these intact when restyling.
{%- endcomment -%}

{%- assign days = 'monday,tuesday,wednesday,thursday,friday,saturday,sunday' | split: ',' -%}

<section
  class="foxy-opening-times"
  data-christmas-eve="{{ section.settings.christmas_eve }}"
  data-christmas-day="{{ section.settings.christmas_day }}"
  data-boxing-day="{{ section.settings.boxing_day }}"
  data-new-years-eve="{{ section.settings.new_years_eve }}"
  data-new-years-day="{{ section.settings.new_years_day }}"
  data-bank-holidays="{{ section.settings.bank_holidays }}"
  data-bank-holiday-dates="{{ section.settings.bank_holiday_dates | default: '' }}"
>
  <div class="foxy-opening-times__inner">
    <header class="foxy-opening-times__intro">
      {%- if section.settings.subheading != blank -%}
        <p class="foxy-opening-times__eyebrow">{{ section.settings.subheading }}</p>
      {%- endif -%}

      <h2 class="section-title foxy-opening-times__title">
        {{ section.settings.title }}
      </h2>

      <div class="foxy-opening-times__status" data-status hidden>
        <span class="foxy-opening-times__status-dot" aria-hidden="true"></span>
        <span class="foxy-opening-times__status-text" data-status-text></span>
      </div>

      {%- if section.settings.text != blank -%}
        <div class="foxy-opening-times__copy">{{ section.settings.text }}</div>
      {%- endif -%}

      <div class="exceptions-note" aria-live="polite"></div>
    </header>

    <div class="foxy-opening-times__panel">
      <table class="opening-times-table">
        <thead>
          <tr>
            <th scope="col">Day</th>
            <th scope="col">Opening Time</th>
            <th scope="col">Closing Time</th>
          </tr>
        </thead>
        <tbody>
          {%- for day in days -%}
            {%- assign open_key = 'opening_time_' | append: day -%}
            {%- assign close_key = 'closing_time_' | append: day -%}
            {%- assign open_val = section.settings[open_key] | strip -%}
            {%- assign close_val = section.settings[close_key] | strip -%}
            {%- assign open_check = open_val | downcase -%}
            <tr class="foxy-opening-times__row{% if open_val == blank or open_check == 'closed' %} is-closed{% endif %}">
              <td>{{ day | capitalize }}</td>
              <td>{{ open_val }}</td>
              <td>{{ close_val }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
  </div>

  <script>
    (() => {
      // Presentational only: highlights today's row and shows a status chip.
      // Runs after foxy-opening-times.js so holiday closures are respected.
      const section = document.currentScript.closest('.foxy-opening-times');
      if (!section) return;

      const run = () => {
        const today = new Date().toLocaleDateString('en-GB', { weekday: 'long' });
        const rows = Array.from(section.querySelectorAll('.opening-times-table tbody tr'));
        const row = rows.find((r) => r.querySelector('td:first-child')?.textContent.trim() === today);
        if (!row) return;

        row.classList.add('is-today');
        row.setAttribute('aria-current', 'date');

        const status = section.querySelector('[data-status]');
        const statusText = section.querySelector('[data-status-text]');
        if (!status || !statusText) return;

        const open = row.querySelector('td:nth-child(2)')?.textContent.trim() || '';
        const close = row.querySelector('td:nth-child(3)')?.textContent.trim() || '';
        const isClosed = row.classList.contains('closed') || row.classList.contains('is-closed') || !open || /^closed$/i.test(open);

        status.classList.toggle('is-closed', isClosed);
        statusText.textContent = isClosed ? 'Closed today' : `Open today · ${open}${close ? ' – ' + close : ''}`;
        status.hidden = false;
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => setTimeout(run, 0));
      } else {
        run();
      }
    })();
  </script>
</section>

